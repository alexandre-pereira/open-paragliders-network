# Nom de domaine du serveur (enregistrement DNS A/AAAA vers le VPS)
LIVE_DOMAIN=live.wesoar.fr

# Clés des logiciels autorisés : nom:clé, séparées par des virgules (openssl rand -hex 24).
# Vide = serveur ouvert à tous (à éviter en production : les noms des pilotes deviendraient publics).
APP_KEYS=wsnav:changez-moi-0123456789abcdef

# Mot de passe du back-office (openssl rand -base64 32). Vide = back-office fermé.
ADMIN_TOKEN=

# Historique et place
RETENTION_HOURS=72
MAX_DB_MB=4096
MIN_FREE_DISK_MB=1000

# Direct
LIVE_WINDOW_MIN=60
PUSH_EVERY=3
MIN_PUSH_EVERY=1
DEFAULT_TRAIL_S=600

# LiveTrack24 (XCSoar, LK8000…) : 1 = accepté
LT24=1
